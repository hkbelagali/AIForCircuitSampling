#!/bin/bash
#SBATCH --job-name=aics_e2e_gpu
#SBATCH --partition=data-machine
#SBATCH --account=data-machine
#SBATCH --time=02:00:00
#SBATCH --gres=gpu:a100:1
#SBATCH --cpus-per-task=2
#SBATCH --mem=16G
#SBATCH --output=results/slurm/aics_e2e_gpu_%j.out
#SBATCH --error=results/slurm/aics_e2e_gpu_%j.err
#
# Example end-to-end aics run on GPU: sample → train (NLL with PT reg) → plot.
# Adapt N, K_TRAIN, HIDDEN, etc. for your run; this is a template, not a
# job-specific script. Copy it elsewhere before editing.
#
# Usage:
#   sbatch slurm/example_e2e_gpu.sb        # run as-is at the defaults below
#   N=24 K=10000 H=128 sbatch slurm/example_e2e_gpu.sb
#

module purge
module load NVHPC/23.7-CUDA-12.1.1
module load OpenMPI/4.1.5-NVHPC-23.7-CUDA-12.1.1
module load FlexiBLAS/3.3.1-NVHPC-23.7-CUDA-12.1.1

PY=/mnt/ffs24/home/rowlan91/.conda/envs/thesisEnv/bin/python3
cd /mnt/ffs24/home/rowlan91/AIForCircuitSampling

# --- run parameters (override via env vars or by editing this file) ---
N=${N:-12}
DEPTH=${DEPTH:-10}
K_MAX=${K_MAX:-100000}
K_TRAIN=${K:-10000}
HIDDEN=${H:-128}
SEED=${SEED:-0}
SAMPLES_DIR=results/tn_samples_aics
RESULTS_DIR=results/m_rcs_nll_aics

mkdir -p $SAMPLES_DIR $RESULTS_DIR results/slurm

# --- Stage A: sample ---
SAMPLE_NPZ=$SAMPLES_DIR/n${N}_d${DEPTH}_cs42_ss0_k${K_MAX}.npz
if [ ! -f "$SAMPLE_NPZ" ]; then
  echo "[stage A] $SAMPLE_NPZ not found — sampling..."
  $PY -u scripts/sample.py \
    --n $N --depth $DEPTH --k_max $K_MAX \
    --sampler exact_tn --dtype complex64 --gpu \
    --out_dir $SAMPLES_DIR
fi

# --- Stage B: train ---
OUT=$RESULTS_DIR/n${N}_d${DEPTH}_k${K_TRAIN}_h${HIDDEN}_s${SEED}.json
LOG_JSON=$RESULTS_DIR/n${N}_d${DEPTH}_k${K_TRAIN}_h${HIDDEN}_s${SEED}.epochs.jsonl
$PY -u scripts/train.py \
  --samples_npz $SAMPLE_NPZ \
  --k_train $K_TRAIN \
  --model_seed $SEED \
  --hidden $HIDDEN \
  --loss nll --pt_regularizer --pt_lambda 0.01 \
  --gpu \
  --log_json $LOG_JSON \
  --out $OUT

# --- Plot (cheap; refreshes from all cells in the dir) ---
$PY -u scripts/plot.py --in_dir $RESULTS_DIR --out_dir plots
